{
  "graph_id": "hp",
  "endpoint": "https://ubergraph.apps.renci.org/sparql",
  "entity_types": [
    "http://www.w3.org/2002/07/owl#Class"
  ],
  "dimensions": [],
  "prefixes": {
    "schema": "http://schema.org/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "dc": "http://purl.org/dc/elements/1.1/",
    "obo": "http://purl.obolibrary.org/obo/",
    "oboInOwl": "http://www.geneontology.org/formats/oboInOwl#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "HP": "http://purl.obolibrary.org/obo/HP_",
    "RO": "http://purl.obolibrary.org/obo/RO_",
    "IAO": "http://purl.obolibrary.org/obo/IAO_"
  },
  "text_blurb": "Ontology hp from Ubergraph.",
  "query_hints": {
    "namespace_scope": "FILTER STRSTARTS(STR(?class), \"http://purl.obolibrary.org/obo/HP_\")",
    "reasoning_mode": "no entailment; use explicit patterns and property paths (e.g., rdfs:subClassOf*)",
    "exclude_obsoletes": true,
    "label_property": "rdfs:label",
    "definition_property": "IAO:0000115",
    "default_behaviors": {
      "consider_descendants": true,
      "sort_results": true,
      "use_distinct": true
    },
    "output_rules": {
      "extension_mode_token": "EXTENSION_MODE",
      "extension_mode_format": "plain_text_no_backticks",
      "normal_mode_format": "fenced_code_block_sparql"
    }
  },
  "obo_foundry_metadata": {
    "id": "hp",
    "title": "Human Phenotype Ontology (HPO)",
    "description": "The Human Phenotype Ontology (HPO) is a structured and controlled vocabulary for the phenotypic features encountered in human hereditary and other disease.",
    "homepage": "http://www.human-phenotype-ontology.org/",
    "license": "hpo",
    "contact": "Sebastian Koehler",
    "domain": "phenotype",
    "products": [
      "hp.json",
      "hp.obo",
      "hp.owl",
      "hp/hp-base.json",
      "hp/hp-base.obo",
      "hp/hp-base.owl",
      "hp/hp-full.json",
      "hp/hp-full.obo",
      "hp/hp-full.owl",
      "hp/hp-international.json",
      "hp/hp-international.obo",
      "hp/hp-international.owl",
      "hp/hp-simple-non-classified.json",
      "hp/hp-simple-non-classified.obo",
      "hp/hp-simple-non-classified.owl",
      "hp/phenotype.hpoa",
      "hp/phenotype_to_genes.txt",
      "hp/genes_to_phenotype.txt"
    ],
    "imports": []
  },
  "good_for": [
    "Phenotype description",
    "Clinical feature annotation",
    "Phenotype-disease associations"
  ],
  "query_patterns": [
    {
      "pattern": "Find all terms in namespace",
      "description": "Filter by namespace scope",
      "sparql_hint": "FILTER STRSTARTS(STR(?term), \"http://purl.obolibrary.org/obo/HP_\")",
      "note": "Use namespace filter early to reduce result set"
    },
    {
      "pattern": "Find all child terms",
      "description": "Traverse hierarchy to find more specific terms",
      "sparql_hint": "?child rdfs:subClassOf+ ?parent .",
      "note": "Use property paths (rdfs:subClassOf+) for transitive hierarchies"
    },
    {
      "pattern": "Find labels for a term",
      "description": "Retrieve human-readable labels",
      "sparql_hint": "?term rdfs:label ?label ."
    },
    {
      "pattern": "Find cross-references to external databases",
      "description": "Link to external databases (UniProt, Ensembl, etc.)",
      "sparql_hint": "?term oboInOwl:hasDbXref ?xref ."
    }
  ],
  "connects_to": [
    {
      "ontology": "MONDO",
      "relationship_type": "direct import",
      "description": "Phenotypes are associated with diseases",
      "example_query": "Find diseases associated with HP:0000001 (abnormality)",
      "mechanism": "HP is imported by MONDO for disease-phenotype axioms",
      "typical_hop_count": 1
    }
  ],
  "domains": [
    "phenotype"
  ]
}